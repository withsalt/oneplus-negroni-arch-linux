# Keep the 7.3 Negroni battery driver enabled in fresh and reused outputs.
CONFIG_BATTERY_QCOM_BATTMGR=m
CONFIG_BATTERY_OPLUS_BATTMGR=m

# WCN6855 firmware manages its own regulatory domain. Allow a user country
# hint so /etc/conf.d/wireless-regdom can select the device's actual location.
CONFIG_EXPERT=y
CONFIG_CFG80211_CERTIFICATION_ONUS=y
CONFIG_ATH_REG_DYNAMIC_USER_REG_HINTS=y
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=y
CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS=y
