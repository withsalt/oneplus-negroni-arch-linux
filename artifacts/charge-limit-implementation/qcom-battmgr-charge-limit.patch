 		val->intval = battmgr->info.charge_type;
@@ -933,6 +999,218 @@ static int qcom_battmgr_set_charge_control(struct qcom_battmgr *battmgr,
 	return qcom_battmgr_request(battmgr, &request, sizeof(request));
