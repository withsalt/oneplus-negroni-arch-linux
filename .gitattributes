* text=auto
*.sh text eol=lf
*.py text eol=lf
*.c text eol=lf
*.h text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.bundle binary
*.tar.gz binary
*.img binary

# Unified diff context lines prefix the original tab indentation with a space.
patches/linux/*.patch whitespace=-space-before-tab
